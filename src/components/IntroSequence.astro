---
// Original cinematic opening (Brief Section 6). No video asset exists for
// this, so the technically realistic alternative is a lightweight,
// GPU-cheap SVG/CSS sequence: the threshold frame draws itself, its
// aperture opens, and the reveal dissolves into the homepage beneath. No
// text or logo appears inside it. Plays once per browser session, is
// skippable with a single tap, and is skipped entirely when the visitor
// prefers reduced motion.
---

<div class="intro" data-intro aria-hidden="true">
  <svg class="intro-svg" viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="intro-glow" cx="50%" cy="50%" r="60%">
        <stop offset="0%" stop-color="var(--sky)" stop-opacity="0.9" />
        <stop offset="100%" stop-color="var(--sky)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect
      class="intro-outline"
      x="60" y="60" width="280" height="400"
      stroke="var(--paper)" stroke-width="1.5"
      pathLength="100"
    />
    <circle class="intro-aperture" cx="200" cy="260" r="0" fill="url(#intro-glow)" />
  </svg>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: intro-dismiss 600ms var(--ease-in-out) 2400ms forwards;
  }

  .intro-svg {
    width: min(46vh, 60vw);
    height: auto;
  }

  .intro-outline {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: intro-draw 1000ms var(--ease-out) 120ms forwards;
  }

  .intro-aperture {
    animation: intro-open 900ms var(--ease-out) 700ms forwards;
  }

  @keyframes intro-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes intro-open {
    from {
      r: 0;
    }
    to {
      r: 150;
    }
  }

  @keyframes intro-dismiss {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .intro[data-skip="true"] {
    animation: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      animation: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>("[data-intro]");

  if (intro) {
    const alreadySeen = sessionStorage.getItem("introSeen") === "true";
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (alreadySeen || prefersReduced) {
      intro.setAttribute("data-skip", "true");
    } else {
      sessionStorage.setItem("introSeen", "true");
      intro.addEventListener("click", () => intro.setAttribute("data-skip", "true"));
      window.setTimeout(() => intro.setAttribute("data-skip", "true"), 3200);
    }
  }
</script>
