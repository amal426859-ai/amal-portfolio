---
import { education } from "../../data/education";

type Props = { locale: "en" | "ar" };
const { locale } = Astro.props as Props;
const ed = education[locale];
---

<section id="education" class="education">
  <div class="container education-grid">
    <div data-reveal>
      <p class="eyebrow">{ed.eyebrow}</p>
      <h2 class="heading education-heading">{ed.heading}</h2>
    </div>

    <div class="education-panel" data-reveal>
      <p class="education-degree">{ed.degree}</p>
      <p class="education-university">{ed.university}</p>
      <div class="education-facts">
        <span>{ed.honors}</span>
        <span class="education-gpa">
          {ed.gpaLabel}: <strong>{ed.gpa}</strong>
        </span>
      </div>

      <div class="education-tools">
        <p class="eyebrow">{ed.toolsLabel}</p>
        <ul class="tools-list">
          {ed.tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .education {
    padding-block: var(--space-2xl);
    background: var(--paper-dim);
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-xl);
  }

  .education-heading {
    font-size: var(--text-3xl);
    margin-top: var(--space-xs);
    max-width: 12ch;
  }

  .education-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
  }

  .education-degree {
    font-weight: 600;
    font-size: var(--text-lg);
    margin-bottom: var(--space-3xs);
  }

  .education-university {
    color: var(--ink-soft);
    margin-bottom: var(--space-sm);
  }

  .education-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--line);
    margin-bottom: var(--space-md);
  }

  .education-gpa strong {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .tools-list {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
