---
import { about } from "../../data/about";
import ThresholdFrame from "../visuals/ThresholdFrame.astro";

type Props = { locale: "en" | "ar" };
const { locale } = Astro.props as Props;
const a = about[locale];
---

<section id="about" class="about">
  <div class="container about-grid">
    <div class="about-copy" data-reveal>
      <p class="eyebrow">{a.eyebrow}</p>
      <h2 class="heading about-heading">{a.heading}</h2>
      <div class="body-copy about-intro">
        {a.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="about-sets-apart" data-reveal>
      <div class="sets-apart-frame">
        <ThresholdFrame accent="pink" variant="arch" />
      </div>
      <h3 class="heading sets-apart-heading">{a.setsApartHeading}</h3>
      <ol class="sets-apart-list">
        {
          a.setsApart.map((item) => (
            <li>
              <p class="sets-apart-label">{item.label}</p>
              <p class="sets-apart-body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-2xl);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-heading {
    font-size: var(--text-3xl);
    margin-block: var(--space-xs) var(--space-md);
    max-width: 16ch;
  }

  .about-intro {
    max-width: 52ch;
  }

  .about-sets-apart {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
    position: relative;
  }

  .sets-apart-frame {
    max-width: 90px;
    margin-bottom: var(--space-md);
    color: var(--pink-deep);
  }

  .sets-apart-heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
    max-width: 22ch;
  }

  .sets-apart-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .sets-apart-list li {
    border-top: 1px solid var(--line);
    padding-top: var(--space-sm);
  }

  .sets-apart-label {
    font-weight: 600;
    margin-bottom: var(--space-3xs);
  }

  .sets-apart-body {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
