---
import { site } from "../../data/site";
import AtmosphereField from "../visuals/AtmosphereField.astro";
import { withBase } from "../../utils/paths";

type Props = { locale: "en" | "ar" };
const { locale } = Astro.props as Props;
const s = site[locale];

const copy = {
  en: { heading: "Have an idea?", sub: "Let's turn it into something worth seeing." },
  ar: { heading: "لديك فكرة؟", sub: "لنعمل على تحويلها إلى شيء يستحق أن يُرى." },
}[locale];
---

<section id="contact" class="contact" data-reveal>
  <AtmosphereField accent="coral" variant="horizon" />
  <div class="container contact-inner">
    <h2 class="heading contact-heading">{copy.heading}</h2>
    <p class="pull-quote contact-sub">{copy.sub}</p>

    <div class="contact-actions">
      <a class="contact-link contact-link--primary" href={`mailto:${s.email}`} dir="ltr">
        {s.email}
      </a>
      <a class="contact-link" href={s.whatsappLink} target="_blank" rel="noopener noreferrer" dir="ltr">
        {s.whatsappDisplay}
      </a>
    </div>

    <p class="contact-location">{s.location}</p>

    <div class="contact-cv">
      <a class="cv-button" href={withBase("/assets/cv/amal-alsofayan-cv.pdf")} download>
        {s.cv.download}
      </a>
      <a class="cv-button cv-button--ghost" href={withBase("/assets/cv/amal-alsofayan-cv.pdf")} target="_blank" rel="noopener noreferrer">
        {s.cv.view}
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: var(--space-3xl) var(--space-2xl);
    text-align: center;
    overflow: hidden;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-heading {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .contact-sub {
    font-size: var(--text-xl);
    color: var(--ink-soft);
    margin-bottom: var(--space-lg);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .contact-link {
    font-size: var(--text-lg);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition: border-color var(--duration-micro) var(--ease-out), color var(--duration-micro) var(--ease-out);
  }

  .contact-link:hover {
    border-color: var(--coral-deep);
    color: var(--coral-deep);
  }

  .contact-location {
    color: var(--ink-faint);
    font-size: var(--text-sm);
    margin-bottom: var(--space-lg);
  }

  .contact-cv {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-size: var(--text-sm);
    padding: 0.85em 1.6em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    transition: transform var(--duration-micro) var(--ease-out), background var(--duration-micro) var(--ease-out);
  }

  .cv-button:hover {
    transform: translateY(-2px);
    background: var(--coral-deep);
  }

  .cv-button--ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .cv-button--ghost:hover {
    background: transparent;
    border-color: var(--coral-deep);
    color: var(--coral-deep);
  }
</style>
